# Copy this file to ".env" (it is git-ignored) and fill in your key. Everything works WITHOUT it:
# the agent is rules-based by default, and the AI-assist switch in the UI stays disabled.

# Optional: enables the "AI assist" switch (an OpenAI model that only CLASSIFIES messages the rules
# did not understand; it never writes replies). Only the text of Alex's message is sent, never his record.
OPENAI_API_KEY=

# Optional: model to use (must support structured JSON output). Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Optional: start with AI assist ON (set to "on"). Default: off. The UI switch overrides it.
AGENT_LLM=off
